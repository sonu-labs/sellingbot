# TGA Store | API — copy to .env and provide real values
BOT_TOKEN=
ADMIN_IDS=
MONGO_URI=
API_ID=
API_HASH=
# Fallback only: prefer setting the TemporaSMS key from /otpadmin (Admin ->
# OTP Services). A database key set there wins over this value and applies
# without a restart. This variable is still read directly by the Server 3
# catalog module, so keep it set if you use Server 3.
TEMPORASMS_API_KEY=

# Server 2 providers (never hard-code these in source)
TGLION_API_KEY=
TGLION_ID=
TGPVA_API_KEY=

BOT_USERNAME=TGAStoreAPIBot
SUPPORT_USERNAME=OfcCuteSmile
UPDATES_CHANNEL=TGAForu
SALES_LOG_CHANNEL=twalllogs
ADMIN_LOG_ID=-1003441797589
SALES_LOG_ID=-1002254383562
MUST_JOIN_CHANNEL=-1003394213814

# Optional payment integrations
UPI_API_KEY=
UPI_API_URL=https://bot.jackdev.tech/paymentlinkbot/api.php
FAMPAY_UPI=
FAMPAY_API_KEY=
FAMPAY_VERIFY_API_URL=https://fampay.rulebreaker.cc/api/v1/payment/verify
OXAPAY_API_KEY=
BINANCE_PAY_ID=
BINANCE_QR_URL=
BINANCE_API_KEY=
BINANCE_SECRET=
DEFAULT_CURRENCY=₹
MIN_BALANCE_REQUIRED=0

# All-app OTP storefront: markup on provider USD cost (fixed USD_TO_INR=100)
# Leave at 0 for cost pricing; set your desired percentage before launch.
# This is the fallback default — an admin can override it at runtime from
# /otpadmin (Settings -> Markup) without a restart.
OTP_MARKUP_PERCENT=0
