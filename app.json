{
  "name": "TGA Store API",
  "description": "Rich-message Telegram marketplace and reseller bot.",
  "keywords": ["python", "telegram", "rich-messages", "marketplace", "api"],
  "env": {
    "BOT_TOKEN": {"description": "Telegram Bot token from BotFather", "required": true},
    "ADMIN_IDS": {"description": "Comma-separated Telegram admin IDs", "required": true},
    "MONGO_URI": {"description": "MongoDB connection URI", "required": true},
    "API_ID": {"description": "Telegram application API ID", "required": true},
    "API_HASH": {"description": "Telegram application API hash", "required": true},
    "TEMPORASMS_API_KEY": {"description": "Temporasms provider key", "required": false},
    "FAMPAY_API_KEY": {"description": "FamPay Rulebreaker verification API key", "required": false},
    "FAMPAY_VERIFY_API_URL": {"description": "FamPay verification endpoint", "value": "https://fampay.rulebreaker.cc/api/v1/payment/verify", "required": false},
    "OXAPAY_API_KEY": {"description": "OxaPay merchant API key", "required": false},
    "BOT_USERNAME": {"description": "Bot username without @", "value": "TGAStoreAPIBot", "required": false},
    "SUPPORT_USERNAME": {"description": "Support username without @", "value": "OfcCuteSmile", "required": false}
  },
  "buildpacks": [{"url": "heroku/python"}],
  "formation": {"worker": {"quantity": 1, "size": "basic"}},
  "stack": "heroku-24"
}
